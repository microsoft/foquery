{
  "name": "@foquery/source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "nx run example:dev",
    "test": "nx run-many -t test",
    "all": "pnpm format && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "prepublish:packages": "pnpm all && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; for (const name of ['foquery', 'foquery-react', 'foquery-dom']) copyFileSync('LICENSE', 'packages/' + name + '/LICENSE');\"",
    "publish:foquery": "pnpm prepublish:packages && pnpm --filter foquery publish",
    "publish:foquery-react": "pnpm prepublish:packages && pnpm --filter foquery-react publish",
    "publish:foquery-dom": "pnpm prepublish:packages && pnpm --filter foquery-dom publish",
    "publish:all": "pnpm prepublish:packages && pnpm --filter foquery publish && pnpm --filter foquery-react publish && pnpm --filter foquery-dom publish",
    "publish:dry-run": "pnpm prepublish:packages && pnpm --filter foquery publish --dry-run && pnpm --filter foquery-react publish --dry-run && pnpm --filter foquery-dom publish --dry-run",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "23.3.0",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "nx": "23.3.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
